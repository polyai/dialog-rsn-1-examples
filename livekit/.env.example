# A Dialog-RSN-1 API key: sign up or log in at https://studio.poly.ai and create one in the API Keys tab
POLY_API_KEY=

# Only for DIALOG_TTS=client: Cartesia speaks the reply
CARTESIA_API_KEY=

# Optional. Set it if your key belongs to a regional workspace, e.g. wss://api.us.poly.ai/v1/realtime
# DIALOG_REALTIME_URL=wss://api.studio.poly.ai/v1/realtime

# Optional. "server" (default): Dialog-RSN-1 speaks the reply. "client": Cartesia speaks it.
# DIALOG_TTS=server

# Only for `lk agent dev` with a LiveKit server, not for `lk agent console`.
# These are the defaults for a local `livekit-server --dev`; use your LiveKit Cloud project's values instead.
# LIVEKIT_URL=ws://localhost:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=secret
